# Copy to .env and fill in. NEVER commit the real .env.

# ---- Django ----
DJANGO_SECRET_KEY=replace-me-generate-a-secure-random-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
DATABASE_URL=

# ---- Email (Gmail SMTP — use a Gmail App Password) ----
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

FRONTEND_URL=http://localhost:3000

# ---- JWT lifetimes ----
ACCESS_TOKEN_LIFETIME_MIN=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# ---- Anthropic (optional — enables /api/insights/) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# ---- Plaid (bank sync) ----
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_COUNTRY_CODES=US
PLAID_WEBHOOK_URL=
PLAID_TOKEN_KEY=

# ---- Celery / email-alert ingestion ----
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=true
EMAIL_INGEST_POLL_SECONDS=60
